  <property name="windowTitle">
   <string>ProtectionTest - контроль средств защиты ПК</string>
  </property>
  <property name="windowIcon">
   <iconset resource="../resources.qrc">
    <normaloff>:/rec/resources/appIcon.png</normaloff>:/rec/resources/appIcon.png</iconset>
  </property>
  <property name="styleSheet">
   <string>QMainWindow, QWidget#centralwidget { background: #0f1117; }
* { font-family: &quot;Segoe UI&quot;; font-size: 10pt; color: #e5e7eb; }

/* Боковое меню */
QFrame#sidebar { background: #151922; border-right: 1px solid #242a35; }
QLabel#appLogo { font-size: 12pt; font-weight: 600; color: #60a5fa; padding: 4px 2px 14px 2px; }
QPushButton[nav=&quot;true&quot;] { text-align: left; padding: 8px 12px; border: none; border-radius: 8px; color: #9ca3af; background: transparent; }
QPushButton[nav=&quot;true&quot;]:hover { background: #1f2430; }
QPushButton[nav=&quot;true&quot;]:checked { background: #1c2a45; color: #60a5fa; }

/* Общий статус */
QFrame#heroCard { background: #181d27; border: 1px solid #262c38; border-radius: 12px; }
QLabel#scoreLabel { border: 5px solid #374151; border-radius: 34px; font-size: 14pt; font-weight: 600; background: transparent; }
QLabel#scoreLabel[state=&quot;ok&quot;]  { border-color: #22c55e; }
QLabel#scoreLabel[state=&quot;bad&quot;] { border-color: #ef4444; }
QLabel#heroTitle { font-size: 13pt; font-weight: 600; background: transparent; }
QLabel#heroSubtitle { color: #9ca3af; background: transparent; }
QPushButton#btnRunAll { background: #3b82f6; color: #ffffff; border: none; border-radius: 8px; padding: 9px 18px; font-weight: 600; }
QPushButton#btnRunAll:hover { background: #2563eb; }
QPushButton#btnRunAll:disabled { background: #1e3a8a; color: #93a3c0; }

/* Карточки проверок */
QFrame[card=&quot;true&quot;] { background: #181d27; border: 1px solid #262c38; border-radius: 12px; }
QFrame[card=&quot;true&quot;][state=&quot;bad&quot;] { border: 1px solid #7f1d1d; }
QFrame#cardSummary { border: 1px dashed #343c4a; background: #141821; }
QFrame[card=&quot;true&quot;] QLabel { background: transparent; border: none; }
QFrame[card=&quot;true&quot;] QLabel[icon=&quot;true&quot;] { background: #232a36; border-radius: 8px; font-size: 14pt; }
QLabel[cardTitle=&quot;true&quot;] { font-weight: 600; }
QLabel[cardDesc=&quot;true&quot;] { color: #9ca3af; font-size: 9pt; }
QFrame[card=&quot;true&quot;] QLabel[pill=&quot;true&quot;] { border-radius: 9px; padding: 2px 9px; font-size: 8pt; background: #262c38; color: #9ca3af; }
QFrame[card=&quot;true&quot;] QLabel[pill=&quot;true&quot;][state=&quot;run&quot;] { background: #3a2c0c; color: #fbbf24; }
QFrame[card=&quot;true&quot;] QLabel[pill=&quot;true&quot;][state=&quot;ok&quot;]  { background: #0e2d1b; color: #4ade80; }
QFrame[card=&quot;true&quot;] QLabel[pill=&quot;true&quot;][state=&quot;bad&quot;] { background: #3b1414; color: #f87171; }
QPushButton[cardButton=&quot;true&quot;] { background: #1f2530; border: 1px solid #343c4a; border-radius: 6px; padding: 5px 10px; }
QPushButton[cardButton=&quot;true&quot;]:hover { background: #283040; }
QPushButton[cardButton=&quot;true&quot;]:disabled { color: #4b5563; }

/* Журнал и отчёт */
QFrame#logCard { background: #181d27; border: 1px solid #262c38; border-radius: 12px; }
QLabel[sectionTitle=&quot;true&quot;] { font-weight: 600; background: transparent; }
QLabel#logPageTitle, QLabel#reportPageTitle { font-size: 15pt; font-weight: 600; }
QPlainTextEdit, QTextBrowser { background: #141821; border: 1px solid #262c38; color: #cbd5e1; selection-background-color: #1d4ed8; border-radius: 8px; padding: 6px; font-family: &quot;Consolas&quot;; font-size: 9pt; }
QFrame#logCard QPlainTextEdit { border: none; background: #181d27; }
QPushButton[secondary=&quot;true&quot;] { background: #1f2530; border: 1px solid #343c4a; border-radius: 8px; padding: 7px 14px; }
QPushButton[secondary=&quot;true&quot;]:hover { background: #283040; }
QStatusBar { background: #151922; border-top: 1px solid #242a35; color: #9ca3af; }
QProgressBar { border: none; background: #262c38; border-radius: 3px; max-height: 6px; }
QProgressBar::chunk { background: #3b82f6; border-radius: 3px; }

QScrollBar:vertical { background: transparent; width: 10px; }
QScrollBar::handle:vertical { background: #343c4a; border-radius: 5px; min-height: 24px; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; }
QToolTip { background: #232a36; color: #e5e7eb; border: 1px solid #343c4a; }</string>
